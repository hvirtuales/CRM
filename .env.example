#--------------------------------------------------------------------
# HV CRM — variables de entorno (copie a .env y ajuste). NUNCA versione .env
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

app.baseURL = 'https://crm.herramientasvirtuales.co/'
app.forceGlobalSecureRequests = true
# Proxys de confianza (Cloudflare/Nginx) para obtener la IP real: 'IP' => 'X-Forwarded-For'
# app.proxyIPs.10.0.0.0/8 = X-Forwarded-For

# Clave de cifrado (secretos MFA, firma de formularios públicos). Genérela con:
#   php spark key:generate --show
encryption.key =

database.default.hostname = 127.0.0.1
database.default.database = hvcrm
database.default.username = hvcrm
database.default.password =
database.default.DBDriver = Postgre
database.default.port = 5432
database.default.charset = utf8

# Segunda barrera de aislamiento: PostgreSQL Row-Level Security sobre tablas cmp_* (true|false)
HV_RLS = true

# Cookies seguras (HTTPS)
cookie.secure = true
cookie.samesite = Lax

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.expiration = 7200

# Correo saliente (invitaciones). Sin esto, las invitaciones no se entregan en producción.
email.fromEmail = 'no-reply@herramientasvirtuales.co'
email.fromName = 'HV CRM'
email.protocol = smtp
email.SMTPHost =
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = tls

# Autoservicio «Pruébelo gratis» (/registro) y enlace a la política de datos
HV_SELF_SIGNUP = true
HV_TERMS_URL = 'https://herramientasvirtuales.co/politica-de-datos'
